---
import { absoluteUrl } from '../lib/urls';
import type { ImageMetadata } from 'astro';
import { renderPhoto, GRID_SIZES } from '../lib/photos';
import Lightbox from './Lightbox.astro';
import { site as siteInfo } from '../config';
import embroideryData from '../data/embroideries.json';
import scrapingbyData from '../data/scrapingby.json';
import artworksData from '../data/artworks.json';

interface Props {
  collection: 'embroideries' | 'scrapingby' | 'artworks';
  title?: string;
}
const { collection, title = collection.charAt(0).toUpperCase() + collection.slice(1) } = Astro.props;

// Globs must be static string literals (Vite requirement).
// Each manifest chooses the published images from its project folder.
const embroideries = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/embroideries/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}',
  { eager: true }
);
const scrapingby = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/scrapingby/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}',
  { eager: true }
);
const artworks = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/artworks/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}',
  { eager: true }
);
const files = { embroideries, scrapingby, artworks }[collection];
const galleryData = { embroideries: embroideryData, scrapingby: scrapingbyData, artworks: artworksData }[collection];

// Preserve the reviewed order and publication settings in each manifest.
const galleryMeta = new Map(galleryData.map((entry) => [entry.file, entry]));
const entries = galleryData.filter((entry) => entry.publish !== false).map((entry): [string, { default: ImageMetadata }] => {
  const path = `../assets/${collection}/${entry.file}`;
  const image = files[path];
  if (!image) throw new Error(`Missing ${collection} image: ${entry.file}`);
  return [path, image];
});

// Fallback alt text from the filename ("01-snowy-harbor.jpg" -> "Snowy harbor")
// for photos without a description yet, so alt / SEO text is never empty.
function captionFor(path: string, index: number): string {
  const base = path.split('/').pop()!.replace(/\.[^.]+$/, '');
  const words = base.replace(/^[\s\d_-]+/, '').replace(/[-_]+/g, ' ').trim();
  if (!words) return `Photograph ${index + 1}`;
  return words.charAt(0).toUpperCase() + words.slice(1);
}

const photos = await Promise.all(
  entries.map(async ([path, mod], i) => {
    const photo = await renderPhoto(mod.default);
    const imported = galleryMeta.get(path.split('/').pop()!);
    const caption = imported?.caption ?? '';
    const alt = caption.trim() ? caption.replace(/\s+/g, ' ').slice(0, 160) : captionFor(path, i);
    return { ...photo, caption, alt, date: imported?.date };
  })
);

// Structured data: an ImageGallery of ImageObjects attributed to the photographer.
// Include captions and dates from the gallery manifest when available.
const url = (path: string) => absoluteUrl(path, Astro.site);
const base = url('/').replace(/\/$/, '');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ImageGallery',
  name: `${title} — ${siteInfo.name}`,
  url: url(Astro.url.pathname),
  isPartOf: { '@id': `${base}/#website` },
  author: { '@id': `${base}/#person` },
  image: photos.map((p) => ({
    '@type': 'ImageObject',
    contentUrl: url(p.full),
    name: p.alt,
    ...(p.caption ? { caption: p.caption } : {}),
    ...(p.date ? { dateCreated: p.date } : {}),
    creator: { '@id': `${base}/#person` },
    copyrightHolder: { '@id': `${base}/#person` },
    creditText: siteInfo.name,
    copyrightNotice: `© ${siteInfo.name}`,
    license: url('/license/'),
    acquireLicensePage: url('/contact/'),
  })),
};
---

{
  photos.length === 0 ? (
    <p class="empty">
      No images yet.
    </p>
  ) : (
    <section class="gallery-grid captioned-gallery" aria-label={`${title} images`}>
      {photos.map((photo, i) => (
        <figure class="gallery-item">
          <button
            class="photo-tile"
            type="button"
            aria-label={`${photo.alt} — view larger`}
            data-full={photo.full}
            data-alt={photo.alt}
            data-caption={photo.caption}
          >
            <img
              class="photo__img"
              src={photo.src}
              srcset={photo.srcset}
              sizes={GRID_SIZES}
              alt={photo.alt}
              loading={i < 4 ? 'eager' : 'lazy'}
              decoding="async"
              draggable={false}
            />
          </button>
          {photo.caption && <figcaption class="gallery-caption">{photo.caption}</figcaption>}
        </figure>
      ))}
    </section>
  )
}

<Lightbox />

<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />

<style>
  .captioned-gallery .gallery-caption {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
    line-height: 1.5;
    min-height: 4.5em;
    white-space: pre-line;
    overflow-wrap: anywhere;
  }
</style>
