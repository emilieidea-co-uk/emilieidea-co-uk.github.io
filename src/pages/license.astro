---
import { withBase } from '../lib/urls';
import Layout from '../layouts/Layout.astro';
import { site } from '../config';
---

<Layout
  title="Artwork & Image Use"
  description={`Copyright and permissions for original artwork, designs, images, and writing by ${site.name}.`}
>
  <article class="page prose">
    <h1 class="page__title">Artwork &amp; Image Use</h1>

    <p class="lede">
      Original artwork, designs, images, and writing on this website are
      © {site.name}, unless otherwise credited. All rights reserved.
    </p>

    <p>
      You’re welcome to browse the work and share links to this website.
      Except where permitted by law, please obtain written permission before
      reproducing, adapting, printing, or using the artwork or images in
      publications, products, or advertising.
    </p>

    <p>
      Purchasing an original artwork does not transfer copyright or reproduction
      rights unless agreed in writing.
    </p>

    <p>Use of the artwork or images for AI training is not authorised.</p>

    <p>
      For permission or licensing enquiries, please get in touch through the
      <a href={withBase('/contact/')}>Contact page</a>.
    </p>
  </article>
</Layout>
