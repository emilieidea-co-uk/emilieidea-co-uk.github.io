---
import { withBase } from '../lib/urls';
import Layout from '../layouts/Layout.astro';
import { site } from '../config';

const lastUpdated = '7 November 2026';
---

<Layout
  title="Privacy"
  description={`A short privacy notice for ${site.name}, including local preferences and links to service privacy policies.`}
>
  <article class="page prose">
    <h1 class="page__title">Privacy</h1>

    <p class="lede">
      {site.name} is an artist portfolio. This site has no accounts, contact
      forms, advertising trackers, or analytics scripts.
    </p>

    <p>
      Your light or dark theme preference is saved in your browser’s local
      storage so it can be remembered on your next visit. This preference is
      not sent to me. You can remove it by clearing this site’s browser data.
    </p>

    <h2>Hosting and external links</h2>
    <p>
      The published site uses GitHub Pages. GitHub logs visitor IP addresses
      for security purposes. Instagram and GitHub links take you to external
      services, which have their own privacy policies:
    </p>

    <ul>
      <li>
        <a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement">
          GitHub Privacy Statement
        </a>
      </li>
      <li>
        <a href="https://privacycenter.instagram.com/policy/">
          Instagram / Meta Privacy Policy
        </a>
      </li>
    </ul>

    <p>
      For questions about this site, please use the
      <a href={withBase('/contact/')}>contact page</a>.
    </p>

    <p><em>Last updated: {lastUpdated}.</em></p>
  </article>
</Layout>
