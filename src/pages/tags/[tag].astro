---
import Layout from '../../layouts/Layout.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import { publishedArtworkGroups } from '../../lib/project-photos';
import { artworkTagIndex, groupsForTag } from '../../lib/artwork-tags.mjs';
import { withBase } from '../../lib/urls';
export function getStaticPaths() {
  const groups = publishedArtworkGroups();
  return artworkTagIndex(groups).map(({ tag, label, count }) => ({
    params: { tag }, props: { tag, label, count, groups: groupsForTag(groups, tag) },
  }));
}
const { tag, label, count, groups } = Astro.props;
---
<Layout title={label} description={`Explore ${count} ${count === 1 ? 'post' : 'posts'} tagged ${label} across EmilieIdea’s collections.`}>
  <div class="tag-heading">
    <p><a class="text-link" href={withBase('/tags/')}>← All tags</a></p>
    <h1 class="gallery-label">{label}</h1>
    <p>{count} {count === 1 ? 'post' : 'posts'} across the collections</p>
  </div>
  <PhotoGrid groups={groups} tag={tag} title={label} />
</Layout>
<style>.tag-heading { margin-bottom: 1.5rem; }</style>
