---
import { Image } from 'astro:assets';
import embroideryLight from '../assets/ei-embroideries-light.png';
import embroideryDark from '../assets/ei-embroideries-dark.png';
import scrapingbyLight from '../assets/ei-scrapingby-light.png';
import scrapingbyDark from '../assets/ei-scrapingby-dark.png';
import artworksLight from '../assets/ei-artworks-light.png';
import artworksDark from '../assets/ei-artworks-dark.png';
import { withBase } from '../lib/urls';

interface Props {
  class?: string;
  category?: import('../lib/project-photos').ProjectCollection;
}
const { class: className, category } = Astro.props;
const base = className ? `${className} ` : '';
const path = Astro.url.pathname.replace(/\/+$/, '');
const inCategory = (route: string) => {
  const root = withBase(route).replace(/\/+$/, '');
  return path === root || path.startsWith(`${root}/`);
};
const [light, dark] = (category === 'scrapingby' || (!category && inCategory('/scrapingby/')))
  ? [scrapingbyLight, scrapingbyDark]
  : (category === 'embroideries' || (!category && inCategory('/embroideries/')))
    ? [embroideryLight, embroideryDark]
    : [artworksLight, artworksDark];
---

{/* Both variants are rendered; CSS shows the one matching the active theme. */}
<Image
  class={`${base}brand__mark--light`}
  src={light}
  alt=""
  widths={[200, 400, 600]}
  sizes="(max-width: 1023px) 118px, 158px"
  loading="eager"
  aria-hidden="true"
/>
<Image
  class={`${base}brand__mark--dark`}
  src={dark}
  alt=""
  widths={[200, 400, 600]}
  sizes="(max-width: 1023px) 118px, 158px"
  loading="eager"
  aria-hidden="true"
/>
