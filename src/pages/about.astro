---
import { withBase } from '../lib/urls';
import Layout from "../layouts/Layout.astro";
import { site } from "../config";
---

<Layout
    title="About"
    description={`About ${site.name} — embroidery, scratchboard, pottery, and printmaking.`}
>
    <article class="page prose">
        <h1 class="page__title">About</h1>

        <p class="lede">
            {site.name} brings together my work with thread, clay, and carved
            surfaces. I’m drawn to botanical shapes, small details, and the
            textures that appear when something is made by hand.
        </p>

        <p>
            <strong><a href={withBase('/artworks/')}>Artworks</a></strong> gathers
            pottery, printmaking, and stitched pieces, including finished work
            and experiments along the way.
        </p>

        <p>
            <strong><a href={withBase('/scrapingby/')}>ScrapingBy</a></strong>
            follows my scratchboard work. By removing parts of a surface, I
            reveal lines, shapes, and patterns—often inspired by flowers and
            leaves.
        </p>

        <p>
            <strong><a href={withBase('/')}>Embroideries</a></strong> collects
            hand stitching, decorative pieces, and visible mending. Existing
            fabrics, small scraps, and worn clothes offer places to begin, with
            each stitch adding another layer to their story.
        </p>

        <p>
            This site is a place to bring those projects together, share the
            process, and keep a record of what develops.
        </p>
    </article>
</Layout>
