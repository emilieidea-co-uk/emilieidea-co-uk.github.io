---
import Layout from '../../layouts/Layout.astro';
import { withBase } from '../../lib/urls';
import { initialStudy } from '../../studio/studies';
import type { Study } from '../../studio/studies';
interface Props { study?: Study; legacy?: boolean }
const { study = initialStudy, legacy = false } = Astro.props;
const image = withBase(`/studio/drawing-to-stitches/preview/${study.id}/share.png`);
const description = `${study.name}: watch a drawing become a hand-stitch pattern, one stitch at a time.`;
---
<Layout standalone fitViewport title="Stitch" fullTitle="EmilieIdea - Stitch" description={description}
  socialImage={{ src: image, width: 1200, height: 630,
    alt: `${study.name} rendered as running stitches on a warm cream background. EmilieIdea - Stitch.` }}>
  <article class="stitch-animation">
    <header class="prose">
      <p><a id="preview-back" href={withBase('/studio/drawing-to-stitches/')}>← Back to edit</a></p>
      <h1>Stitch</h1>
      <p id="preview-description">{description}</p>
    </header>
    <div class="preview-controls" aria-label="Animation controls">
      <button id="preview-play" type="button" disabled>Pause</button>
      <button id="preview-restart" type="button" disabled>Restart</button>
      <button id="preview-share" type="button" disabled>Share</button>
    </div>
    <p id="preview-share-status" class="share-status" role="status" aria-live="polite"></p>
    <figure>
      <canvas data-drawing={legacy ? undefined : study.id} data-legacy={legacy ? "true" : undefined} id="preview-canvas" width="600" height="440" role="img" aria-label="Animated hand-stitch study" aria-describedby="preview-status"></canvas>
      <figcaption id="preview-status" role="status" aria-live="polite">Preparing the stitch animation…</figcaption>
    </figure>
    <p class="preview-original"><a href={withBase('/artwork/instagram-CWO3doINYa7-01/')}>View original post →</a></p>
    <noscript><p>Turn on JavaScript to watch the stitch animation.</p></noscript>
  </article>
</Layout>
<script>
  import { initStitchPreview } from '../../studio/preview';
  try { initStitchPreview(); }
  catch (error) {
    console.error('Studio preview failed:', error);
    const status = document.getElementById('preview-status');
    if (status) status.textContent = error instanceof Error ? `${error.message} Use Back to edit to adjust your pattern.` : 'The preview could not load. Use Back to edit to try another pattern.';
  }
</script>
<style>
  .stitch-animation { display: flex; flex-direction: column; gap: clamp(.35rem, 1.2vh, .75rem); height: 100%; min-height: 0; width: 100%; min-width: 0; margin-inline: auto; }
  header.prose { flex-shrink: 0; width: 100%; max-width: none; margin-inline: 0; text-align: left; }
  header.prose p { margin: 0; text-align: left; }
  header h1 { font-size: clamp(1.7rem, 4vh, 2.8rem); line-height: 1.1; margin: .35rem 0; }
  #preview-description { font-size: clamp(1rem, 2vh, 1.15rem); line-height: 1.35; }
  .preview-controls { display: flex; flex-shrink: 0; flex-wrap: nowrap; gap: .75rem; margin: 0; }
  button { font: inherit; color: var(--fg); background: var(--bg); border: 1px solid var(--muted); border-radius: 3px; padding: .5rem .75rem; min-height: 44px; min-width: 0; }
  button { cursor: pointer; }
  button:focus-visible { outline: 2px solid var(--fg); outline-offset: 3px; }
  button:disabled { opacity: .5; cursor: not-allowed; }
  .share-status { flex-shrink: 0; color: var(--muted); font-size: 1rem; line-height: 1.25; margin: 0; }
  .share-status:empty { display: none; }
  figure { display: flex; flex-direction: column; flex: 1; min-height: 0; gap: .35rem; margin: 0; }
  canvas { display: block; flex: 1; min-height: 0; width: 100%; height: 0; object-fit: contain; background: #f5f1e7; border-radius: 3px; }
  figcaption { flex-shrink: 0; color: var(--muted); font-size: 1rem; line-height: 1.25; margin: 0; }
  .preview-original { flex-shrink: 0; font-size: 1rem; line-height: 1.25; margin: 0; }
  @media (max-width: 640px) {
    .preview-controls { gap: .5rem; }
    button { font-size: 1rem; padding-inline: .6rem; }
  }
</style>
