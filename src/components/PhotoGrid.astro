---
import { absoluteUrl } from '../lib/urls';
import { GRID_SIZES } from '../lib/photos';
import Lightbox from './Lightbox.astro';
import { site as siteInfo } from '../config';
import { publishedArtworkGroups, renderArtworkGroup, collectionInfo } from '../lib/project-photos';

interface Props {
  collection: 'embroideries' | 'scrapingby' | 'artworks';
  title?: string;
}
const { collection, title = collection.charAt(0).toUpperCase() + collection.slice(1) } = Astro.props;
const groups = publishedArtworkGroups().filter(group => group.collection === collection);
const posts = await Promise.all(groups.map(async group => {
  const slides = await renderArtworkGroup(group);
  return { cover: slides[0], slides };
}));
const photos = posts.flatMap(post => post.slides);

// Structured data: an ImageGallery of ImageObjects attributed to the artist.
// Include captions and dates from the gallery manifest when available.
const url = (path: string) => absoluteUrl(path, Astro.site);
const base = url('/').replace(/\/$/, '');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ImageGallery',
  name: `${title} — ${siteInfo.name}`,
  url: url(Astro.url.pathname),
  isPartOf: { '@id': `${base}/#website` },
  author: { '@id': `${base}/#person` },
  image: photos.map((p) => ({
    '@type': 'ImageObject',
    contentUrl: url(p.full),
    url: url(p.href),
    name: p.alt,
    ...(p.caption ? { caption: p.caption } : {}),
    ...(p.date ? { dateCreated: p.date } : {}),
    creator: { '@id': `${base}/#person` },
    copyrightHolder: { '@id': `${base}/#person` },
    creditText: siteInfo.name,
    copyrightNotice: `© ${siteInfo.name}`,
    license: url('/license/'),
    acquireLicensePage: url('/contact/'),
  })),
};
---

{
  posts.length === 0 ? (
    <p class="empty">
      No images yet.
    </p>
  ) : (
    <section class="gallery-grid captioned-gallery" aria-label={`${title} images`}>
      {posts.map(({ cover: photo, slides }, i) => (
        <figure class="gallery-item">
          <button
            class="photo-tile"
            type="button"
            aria-label={`${photo.alt} — view larger${slides.length > 1 ? `, ${slides.length} images in this post` : ''}`}
            data-photo-group={JSON.stringify(slides)}
            data-full={photo.full}
            data-artwork-url={photo.href}
            data-alt={photo.alt}
            data-caption={photo.caption}
          >
            <img
              class="photo__img"
              src={photo.src}
              srcset={photo.srcset}
              sizes={GRID_SIZES}
              alt={photo.alt}
              loading={i < 4 ? 'eager' : 'lazy'}
              decoding="async"
              draggable={false}
            />
            {slides.length > 1 && <span class="gallery-image-count" aria-hidden="true">▣ {slides.length}</span>}
          </button>
          {photo.caption && <figcaption class="gallery-caption">{photo.caption}</figcaption>}
        </figure>
      ))}
    </section>
  )
}

<p class="gallery-instagram">
  <a class="text-link" href={collectionInfo[collection].instagram} target="_blank" rel="noopener noreferrer">View more on Instagram →</a>
</p>

<Lightbox />

<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />

<style>
  .gallery-instagram { margin-block: 2rem; }
  .captioned-gallery .gallery-caption {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
    line-height: 1.5;
    min-height: 4.5em;
    white-space: pre-line;
    overflow-wrap: anywhere;
  }
</style>
