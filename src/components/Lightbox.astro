---
// Shared full-screen photo viewer. Wires up every `.photo-tile` button on the
// page (each carries data-full, data-alt, and optional data-caption).
---

<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Photo viewer" aria-hidden="true">
  <span class="lightbox__position" role="status" aria-live="polite" hidden></span>
  <button class="lightbox__close" type="button" aria-label="Close viewer">&times;</button>
  <button class="lightbox__nav lightbox__prev" type="button" aria-label="Previous photo">&#8249;</button>
  <figure class="lightbox__figure" tabindex="0" aria-label="Artwork image and caption">
    <img class="lightbox__img" alt="" draggable="false" />
    <figcaption class="lightbox__caption" hidden>
      <span class="lightbox__caption-text" id="lightbox-caption-text"></span>
      <button class="lightbox__more" type="button" aria-expanded="false" aria-controls="lightbox-caption-text" hidden>More</button>
    </figcaption>
    <nav class="artwork-tags" aria-label="Image tags" hidden></nav>
  </figure>
  <div class="lightbox__sharing" hidden>
    <button class="lightbox__copy" type="button">Copy Link</button>
    <span class="lightbox__status" role="status" aria-live="polite"></span>
    <input class="lightbox__url" type="text" readonly aria-label="Artwork link — select and copy" hidden />
  </div>
  <button class="lightbox__nav lightbox__next" type="button" aria-label="Next photo">&#8250;</button>
</div>

<script>
  import '../lib/lightbox.mjs';
</script>
