---
import type { ImageMetadata } from 'astro';
import { renderPhoto, POST_SIZES, captionFromFilename } from '../lib/photos';
import { projectPhoto, type ProjectCollection } from '../lib/project-photos';

// A single in-post photo — rendered through the same web-resolution pipeline as
// the galleries (responsive WebP, capped at MAX_WEB) and wired to the shared
// Lightbox that BlogPost includes. Drop images in src/assets/blog/ and reference
// them by filename (no import needed):
//
//     <Photo src="lake-erie-fog.jpg" caption="Lake Erie, fog" />
//
interface Props {
  src: string; // filename within src/assets/blog/ (subfolders allowed)
  collection?: ProjectCollection; // optionally reuse a published project image
  alt?: string; // defaults to the caption, else derived from the filename
  caption?: string; // optional visible caption (also shown in the lightbox)
}
const { src, alt, caption, collection } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/blog/**/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}',
  { eager: true }
);
const project = collection ? projectPhoto(collection, src) : undefined;
const match = collection ? undefined : Object.entries(images).find(
  ([path]) => path.endsWith('/' + src) || path.split('/').pop() === src
);
if (!collection && !match) {
  throw new Error(
    `<Photo src="${src}"> not found in src/assets/blog/. Add the file there and reference it by filename.`
  );
}

const captionText = caption ?? project?.caption ?? '';
const altText = alt ?? (captionText.trim() || captionFromFilename(src));
const image = project?.image ?? match?.[1].default;
const photo = image ? await renderPhoto(image) : undefined;
---

{photo && <figure class="post-figure">
  <button
    class="photo-tile"
    type="button"
    aria-label={`${altText} — view larger`}
    data-full={photo.full}
    data-alt={altText}
    data-caption={captionText}
  >
    <img
      class="photo__img"
      src={photo.src}
      srcset={photo.srcset}
      sizes={POST_SIZES}
      alt={altText}
      loading="lazy"
      decoding="async"
      draggable={false}
    />
  </button>
  {captionText && <figcaption class="post-figure__caption">{captionText}</figcaption>}
</figure>}
