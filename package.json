{
  "name": "astro-photo-folio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 4321",
    "start": "astro dev --host 0.0.0.0 --port 4321",
    "build": "astro build && node scripts/strip-unreferenced-assets.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "setup": "npm run gen:brand && npm run gen:icons && npm run gen:placeholders",
    "gen:brand": "node scripts/generate-brand.mjs",
    "gen:icons": "node scripts/generate-icons.mjs",
    "gen:placeholders": "node scripts/generate-placeholders.mjs",
    "assign:ids": "node scripts/assign-artwork-ids.mjs",
    "test:artworks": "node --test tests/artwork-data.test.mjs tests/artwork-tags.test.mjs tests/gallery-masonry.test.mjs tests/lightbox.test.mjs tests/carousel.test.mjs && python3 tests/import-artwork-ids.test.py",
    "test:artwork-build": "python3 tests/verify-artwork-build.py",
    "check:studio": "node scripts/studio-catalog.mjs && tsc -p tsconfig.studio.json",
    "test:studio": "node scripts/studio-catalog.mjs && node --experimental-strip-types --test tests/studio.test.ts tests/studio-catalog.test.mjs tests/studio-controls.test.mjs tests/studio-preview.test.mjs",
    "import:instagram": "node import_tool/import-instagram.mjs",
    "test:import": "node --test import_tool/tests/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/cormorant-garamond": "^5.0.0",
    "@fontsource/eb-garamond": "^5.0.0",
    "astro": "^7.3.6",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "svgo": "4.1.0",
    "typescript": "5.9.3"
  }
}
