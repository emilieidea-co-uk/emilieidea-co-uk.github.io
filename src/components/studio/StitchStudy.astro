---
import { studies, initialStudy, studySvg } from '../../studio/studies';
import { CONTROL_VALUES, PATTERNS } from '../../studio/options.mjs';
import { stageTitle } from '../../studio/navigation';
const defaults = initialStudy.defaults;
---
<section class="stitch-study" aria-label="Running stitch study">
  <h2 id="study-stage" aria-live="polite" aria-atomic="true">{stageTitle(initialStudy, 1)}</h2>
  <div class="stitch-controls is-drawing-only" id="study-controls">
    <label for="study-drawing" id="study-drawing-control">Study drawing
      <select id="study-drawing">{studies.map(study => <option value={study.id} selected={study.id === initialStudy.id}>{study.name}</option>)}</select>
    </label>
    <label for="study-length" data-stitch-setting hidden>Stitch length
      <select id="study-length" disabled>
        {CONTROL_VALUES.length.map(value => <option value={value} selected={value === defaults.length}>{value}</option>)}
      </select>
    </label>
    <label for="study-gap" data-stitch-setting hidden>Gap
      <select id="study-gap" disabled>
        {CONTROL_VALUES.gap.map(value => <option value={value} selected={value === defaults.gap}>{value}</option>)}
      </select>
    </label>
    <label for="study-line-width" data-stitch-setting hidden>Line width
      <select id="study-line-width" disabled>
        {CONTROL_VALUES.lineWidth.map(value => <option value={value} selected={value === defaults.lineWidth}>{value}</option>)}
      </select>
    </label>
  </div>
  <fieldset class="stitch-pattern-controls" id="study-pattern-controls" aria-label="Pattern fill" hidden>
    <div class="stitch-pattern-options">
    <label for="study-pattern">Pattern
      <select id="study-pattern" disabled>
        {PATTERNS.map(value => <option value={value} selected={value === defaults.pattern}>{value[0].toUpperCase() + value.slice(1)}</option>)}
      </select>
    </label>
    <label for="study-spacing">Pattern spacing
      <select id="study-spacing" disabled>{CONTROL_VALUES.spacing.map(value => <option value={value} selected={value === defaults.spacing}>{value}</option>)}</select>
    </label>
    <label for="study-angle">Direction
      <select id="study-angle" disabled>{CONTROL_VALUES.angle.map(value => <option value={value} selected={value === defaults.angle}>{value}°</option>)}</select>
    </label>
    <label for="study-fill-line-width">Fill line width
      <select id="study-fill-line-width" disabled>
        {CONTROL_VALUES.fillLineWidth.map(value => <option value={value} selected={value === defaults.fillLineWidth}>{value}</option>)}
      </select>
    </label>
    </div>
  </fieldset>
  <div class="stitch-previews" id="study-previews">
    <figure id="study-drawing-preview">
      <div class="stitch-paper" id="study-original" set:html={studySvg(initialStudy)} />
    </figure>
    <figure id="study-stitch-preview" hidden>
      <div class="stitch-paper" id="study-canvas" aria-busy="true"></div>
    </figure>
  </div>
  <p class="stitch-status" id="study-status" role="alert" hidden></p>
  <div class="stitch-actions">
    <button id="study-prev" type="button" disabled>Prev</button>
    <button id="study-next" type="button" disabled>Next</button>
    <button id="study-reset" type="button" disabled>Reset</button>
  </div>
  <noscript><p>Turn on JavaScript to try the stitch preview. You can still view the study drawing above.</p></noscript>
</section>
<script>
  import { initDrawingSelection } from '../../studio/drawing-selection';
  import { initStitchStudy } from '../../studio/canvas';
  initDrawingSelection();
  try {
    initStitchStudy();
  } catch (error) {
    console.error('Studio could not start:', error);
    const status = document.getElementById('study-status');
    if (status) {
      status.hidden = false;
      status.textContent = 'You can still choose a drawing. The stitch preview could not load; refresh to try the next steps again.';
    }
    document.getElementById('study-canvas')?.setAttribute('aria-busy', 'false');
  }
</script>
<style>
  .stitch-study { display: flex; flex-direction: column; flex: 1; min-height: 0; margin: 0; width: 100%; max-width: 100%; min-width: 0; }
  .stitch-controls, .stitch-pattern-options { display: grid; grid-template-columns: repeat(4, minmax(7rem, 1fr)); align-items: end; gap: 1rem; border-block: 1px solid var(--line); padding-block: 1rem; overflow-x: auto; max-width: 100%; min-width: 0; }
  .stitch-controls, .stitch-pattern-controls { flex-shrink: 0; margin: .5rem 0; padding: .75rem; border: 1px solid var(--line); min-width: 0; width: 100%; max-width: 100%; }
  .stitch-pattern-options { border: 0; padding-block: 0; }
  .stitch-actions { display: flex; flex-shrink: 0; justify-content: flex-end; gap: .75rem; margin: .5rem 0 0; }
  .stitch-controls { grid-template-columns: repeat(3, minmax(7rem, 1fr)); }
  .stitch-controls.is-drawing-only { grid-template-columns: minmax(0, 1fr); }
  .stitch-controls.is-drawing-only label { max-width: 28rem; flex-wrap: nowrap; justify-content: flex-start; gap: .75rem; white-space: nowrap; }
  .stitch-controls.is-drawing-only select { width: auto; flex: 1; }
  #study-stage { flex-shrink: 0; margin: .25rem 0; font-size: clamp(1.4rem, 3.5vh, 2rem); line-height: 1.2; }
  [hidden] { display: none !important; }
  label { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .35rem; font-size: 1rem; min-width: 0; }
  select, button { font: inherit; color: var(--fg); background: var(--bg); border: 1px solid var(--muted); border-radius: 3px; padding: .5rem .65rem; min-height: 44px; }
  select { width: 100%; min-width: 0; }
  button { cursor: pointer; }
  :is(button, select):focus-visible { outline: 2px solid var(--fg); outline-offset: 3px; }
  :is(button, select):disabled { opacity: .5; cursor: not-allowed; }
  .stitch-previews { display: flex; flex-direction: column; flex: 1; min-height: 0; width: 100%; min-width: 0; }
  figure { display: flex; flex-direction: column; flex: 1; min-height: 0; margin: 0; min-width: 0; }
  .stitch-paper { flex: 1; min-height: 0; height: 0; width: 100%; background: #f5f1e7; border-radius: 3px; overflow: hidden; }
  .stitch-paper :global(svg), .stitch-paper :global(canvas) { display: block; width: 100% !important; height: 100% !important; object-fit: contain; }
  .stitch-status { flex-shrink: 0; color: var(--muted); font-size: 1rem; margin: .5rem 0 0; }
  @media (max-width: 640px) {
    .stitch-actions button { flex: 1; }
  }
</style>
